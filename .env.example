# ARQUIVO DE EXEMPLO: todos os valores abaixo são exemplos.
# Copie para .env e troque pelos valores do seu servidor. Este arquivo NÃO tem segredos:
# usuário/senha do rc ficam em ./secrets/rc_user e ./secrets/rc_pass.

# Nome do remote criado no `rclone config` (sem os dois pontos). Exemplo: gdrive
RCLONE_REMOTE=gdrive

# Versão da imagem do rclone (fixa, para não mudar sozinha)
RCLONE_VERSAO=1.75.2

# Onde a nuvem aparece no host: MOUNT_PAI/MOUNT_PASTA (= /mnt/cloud).
# O Samba compartilha /mnt/cloud. O container recebe a pasta-pai inteira
# (/mnt), então não guarde outras coisas em /mnt.
MOUNT_PAI=/mnt
MOUNT_PASTA=cloud

# Dono dos arquivos no mount e usuário do painel (exemplo; veja os seus com: id)
PUID=1000
PGID=1000

# Cache VFS no SSD
VFS_CACHE_MAX_SIZE=40G
VFS_CACHE_MAX_AGE=72h
VFS_CACHE_MIN_FREE_SPACE=10G
DIR_CACHE_TIME=12h
RCLONE_LOG_LEVEL=INFO

# Painel: publique só na interface da LAN (IP do Guts).
# EXEMPLO: troque pelo IP do seu servidor na LAN (veja com: ip -4 addr).
# 0.0.0.0 abre em todas as interfaces; 127.0.0.1 só no próprio Guts.
PAINEL_BIND_IP=192.168.1.10
PAINEL_PORTA=8080

# 1 = dados falsos, não precisa do rclone (desenvolvimento)
RCLONE_MOCK=0
